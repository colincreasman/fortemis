/*
 * Fortemis: 36 keys, 18 per half, each wired straight from its own XIAO
 * nRF52840 Plus pin to GND. There are no diodes and no matrix, so the kscan is
 * a direct-wired one, with each half's pins in its own overlay.
 *
 * The matrix transform is a single row of 36 columns. Each half reports its
 * keys in keymap order (rows top, home, bottom, then the thumbs; left to right)
 * as columns 0-17, and the right half's col-offset moves its keys to 18-35.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
    };

    // What ZMK Studio draws, taken from the switch positions on the PCBs.
    // 1 key unit = 18 mm (the Choc column pitch); keys are Choc keycap sized.
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;

        // begin: generated by ergogen/tools/zmk.py
        //                            w  h    x   y     rot   rx  ry
        keys  = <&key_physical_attrs 97 92    7  96 (-1000)   56 142>  //  0 left top pinky
              , <&key_physical_attrs 97 92  123  28  (-400)  171  74>  //  1 left top ring
              , <&key_physical_attrs 97 92  239   0       0  288  46>  //  2 left top middle
              , <&key_physical_attrs 97 92  339  16       0  388  62>  //  3 left top index
              , <&key_physical_attrs 97 92  439  28       0  488  74>  //  4 left top inner
              , <&key_physical_attrs 97 92 1106  28       0 1154  74>  //  5 right top inner
              , <&key_physical_attrs 97 92 1206  16       0 1254  62>  //  6 right top index
              , <&key_physical_attrs 97 92 1306   0       0 1354  46>  //  7 right top middle
              , <&key_physical_attrs 97 92 1422  28     400 1471  74>  //  8 right top ring
              , <&key_physical_attrs 97 92 1538  96    1000 1586 142>  //  9 right top pinky
              , <&key_physical_attrs 97 92   24 189 (-1000)   72 235>  // 10 left home pinky
              , <&key_physical_attrs 97 92  129 122  (-400)  178 168>  // 11 left home ring
              , <&key_physical_attrs 97 92  239  94       0  288 140>  // 12 left home middle
              , <&key_physical_attrs 97 92  339 111       0  388 157>  // 13 left home index
              , <&key_physical_attrs 97 92  439 122       0  488 168>  // 14 left home inner
              , <&key_physical_attrs 97 92 1106 122       0 1154 168>  // 15 right home inner
              , <&key_physical_attrs 97 92 1206 111       0 1254 157>  // 16 right home index
              , <&key_physical_attrs 97 92 1306  94       0 1354 140>  // 17 right home middle
              , <&key_physical_attrs 97 92 1416 122     400 1464 168>  // 18 right home ring
              , <&key_physical_attrs 97 92 1521 189    1000 1570 235>  // 19 right home pinky
              , <&key_physical_attrs 97 92   40 282 (-1000)   89 328>  // 20 left bottom pinky
              , <&key_physical_attrs 97 92  136 216  (-400)  184 262>  // 21 left bottom ring
              , <&key_physical_attrs 97 92  239 189       0  288 235>  // 22 left bottom middle
              , <&key_physical_attrs 97 92  339 205       0  388 251>  // 23 left bottom index
              , <&key_physical_attrs 97 92  439 216       0  488 262>  // 24 left bottom inner
              , <&key_physical_attrs 97 92 1106 216       0 1154 262>  // 25 right bottom inner
              , <&key_physical_attrs 97 92 1206 205       0 1254 251>  // 26 right bottom index
              , <&key_physical_attrs 97 92 1306 189       0 1354 235>  // 27 right bottom middle
              , <&key_physical_attrs 97 92 1409 216     400 1458 262>  // 28 right bottom ring
              , <&key_physical_attrs 97 92 1505 282    1000 1553 328>  // 29 right bottom pinky
              , <&key_physical_attrs 97 92  454 336    2500  503 382>  // 30 left near thumb
              , <&key_physical_attrs 97 92  536 399    2500  584 445>  // 31 left far thumb
              , <&key_physical_attrs 97 92 1009 399 (-2500) 1058 445>  // 32 right far thumb
              , <&key_physical_attrs 97 92 1091 336 (-2500) 1139 382>  // 33 right near thumb
              ;
        // end: generated
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <36>;
        rows = <1>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)           RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22)
            RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)           RC(0,23) RC(0,24) RC(0,25) RC(0,26) RC(0,27)
            RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)          RC(0,28) RC(0,29) RC(0,30) RC(0,31) RC(0,32)
                              RC(0,15) RC(0,16) RC(0,17)          RC(0,33) RC(0,34) RC(0,35)
        >;
    };
};
