/*
 * Fortemis: 36 keys, 18 per half, each wired straight from its own XIAO
 * nRF52840 Plus pin to GND. There are no diodes and no matrix, so the kscan is
 * a direct-wired one, with each half's pins in its own overlay.
 *
 * The matrix transform is a single row of 36 columns. Each half reports its
 * keys in keymap order (rows top, home, bottom, then the thumbs; left to right)
 * as columns 0-17, and the right half's col-offset moves its keys to 18-35.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
    };

    // What ZMK Studio draws, taken from the switch positions on the PCBs.
    // 1 key unit = 18 mm (the Choc column pitch); keys are Choc keycap sized.
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;

        // begin: generated by ergogen/tools/zmk.py
        //                            w  h    x   y     rot   rx  ry
        keys  = <&key_physical_attrs 97 92    7 122 (-1000)   56 168>  //  0 left top pinky
              , <&key_physical_attrs 97 92  121  45  (-400)  169  91>  //  1 left top ring
              , <&key_physical_attrs 97 92  236   0       0  285  46>  //  2 left top middle
              , <&key_physical_attrs 97 92  336  30       0  385  76>  //  3 left top index
              , <&key_physical_attrs 97 92  436  44       0  485  90>  //  4 left top inner
              , <&key_physical_attrs 97 92 1103  44       0 1151  90>  //  5 right top inner
              , <&key_physical_attrs 97 92 1203  30       0 1251  76>  //  6 right top index
              , <&key_physical_attrs 97 92 1303   0       0 1351  46>  //  7 right top middle
              , <&key_physical_attrs 97 92 1418  45     400 1467  91>  //  8 right top ring
              , <&key_physical_attrs 97 92 1532 122    1000 1580 168>  //  9 right top pinky
              , <&key_physical_attrs 97 92   24 215 (-1000)   72 261>  // 10 left home pinky
              , <&key_physical_attrs 97 92  128 139  (-400)  176 185>  // 11 left home ring
              , <&key_physical_attrs 97 92  236  94       0  285 140>  // 12 left home middle
              , <&key_physical_attrs 97 92  336 125       0  385 171>  // 13 left home index
              , <&key_physical_attrs 97 92  436 139       0  485 185>  // 14 left home inner
              , <&key_physical_attrs 97 92 1103 139       0 1151 185>  // 15 right home inner
              , <&key_physical_attrs 97 92 1203 125       0 1251 171>  // 16 right home index
              , <&key_physical_attrs 97 92 1303  94       0 1351 140>  // 17 right home middle
              , <&key_physical_attrs 97 92 1412 139     400 1460 185>  // 18 right home ring
              , <&key_physical_attrs 97 92 1515 215    1000 1564 261>  // 19 right home pinky
              , <&key_physical_attrs 97 92   40 308 (-1000)   89 354>  // 20 left bottom pinky
              , <&key_physical_attrs 97 92  134 233  (-400)  183 279>  // 21 left bottom ring
              , <&key_physical_attrs 97 92  236 189       0  285 235>  // 22 left bottom middle
              , <&key_physical_attrs 97 92  336 219       0  385 265>  // 23 left bottom index
              , <&key_physical_attrs 97 92  436 233       0  485 279>  // 24 left bottom inner
              , <&key_physical_attrs 97 92 1103 233       0 1151 279>  // 25 right bottom inner
              , <&key_physical_attrs 97 92 1203 219       0 1251 265>  // 26 right bottom index
              , <&key_physical_attrs 97 92 1303 189       0 1351 235>  // 27 right bottom middle
              , <&key_physical_attrs 97 92 1405 233     400 1454 279>  // 28 right bottom ring
              , <&key_physical_attrs 97 92 1499 308    1000 1548 354>  // 29 right bottom pinky
              , <&key_physical_attrs 97 92  482 369    2616  530 415>  // 30 left tuck thumb
              , <&key_physical_attrs 97 92  574 431    4116  623 477>  // 31 left near thumb
              , <&key_physical_attrs 97 92  648 515    5616  697 561>  // 32 left far thumb
              , <&key_physical_attrs 97 92  891 515 (-5616)  939 561>  // 33 right far thumb
              , <&key_physical_attrs 97 92  965 431 (-4116) 1013 477>  // 34 right near thumb
              , <&key_physical_attrs 97 92 1058 369 (-2616) 1106 415>  // 35 right tuck thumb
              ;
        // end: generated
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <36>;
        rows = <1>;

        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)           RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22)
            RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)           RC(0,23) RC(0,24) RC(0,25) RC(0,26) RC(0,27)
            RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)          RC(0,28) RC(0,29) RC(0,30) RC(0,31) RC(0,32)
                              RC(0,15) RC(0,16) RC(0,17)          RC(0,33) RC(0,34) RC(0,35)
        >;
    };
};
